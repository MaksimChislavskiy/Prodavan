# Создайте на сервере файл ~/prodavan-deploy/.env по этому примеру.
# Этот файл-пример можно хранить в Git, а настоящий .env нельзя коммитить.

DJANGO_SECRET_KEY=replace-with-long-random-secret-at-least-50-symbols
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=pyprojects.online,www.pyprojects.online,80.93.60.62,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://pyprojects.online,http://www.pyprojects.online

POSTGRES_DB=prodavan
POSTGRES_USER=prodavan
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql://prodavan:replace-with-strong-postgres-password@db:5432/prodavan

JWT_SIGNING_KEY=replace-with-another-long-random-secret-at-least-50-symbols
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# 32 случайных байта в URL-safe Base64.
INTEGRATION_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key
INTEGRATION_ENCRYPTION_KEY_ID=v1

TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT=10
TELEGRAM_WEBHOOK_BASE_URL=http://pyprojects.online

CHANNEL_REDIS_URL=redis://redis:6379/0

AI_EMBEDDINGS_BASE_URL=
AI_EMBEDDINGS_API_KEY=
AI_EMBEDDINGS_MODEL=
AI_EMBEDDINGS_TIMEOUT=30
AI_EMBEDDINGS_BATCH_SIZE=32

AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_PROVIDER=openai-compatible
AI_CHAT_TIMEOUT=30
AI_CHAT_RETRY_ATTEMPTS=3
AI_CHAT_MAX_CONTEXT_TOKENS=20000
AI_CHAT_RETRIEVAL_LIMIT=5
AI_RETRIEVAL_MIN_SCORE=0.2

AUTH_REFRESH_COOKIE_NAME=refresh
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@pyprojects.online
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
