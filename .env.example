# Скопируйте этот файл в .env. Сам .env исключён из Git.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Для production установите DEBUG=False, укажите домены выше и включите HTTPS.
# HSTS preload включайте только когда основной домен и все поддомены постоянно
# доступны по HTTPS. Начните с небольшого HSTS_SECONDS и увеличьте до 31536000.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Включайте только если Django находится за доверенным reverse proxy, который
# перезаписывает X-Forwarded-Proto. X-Forwarded-Host обычно не требуется.
DJANGO_TRUST_PROXY_HEADERS=False
DJANGO_USE_X_FORWARDED_HOST=False

# Database. SQLite используется только для локальной разработки и тестов.
# Для production задайте postgresql и заполните все параметры подключения.
DATABASE_ENGINE=sqlite
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_SSLMODE=require
DATABASE_CONNECT_TIMEOUT=10
DATABASE_CONN_MAX_AGE=60
DATABASE_APPLICATION_NAME=prodavan

# Логи выводятся в stdout. Для production используйте INFO и json.
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# JWT: используйте отдельный случайный ключ, не совпадающий с DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=replace-with-another-long-random-value
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# 32 случайных байта в URL-safe Base64. Это master key для шифрования
# токенов интеграций в БД; сами Telegram-токены сюда не помещаются.
INTEGRATION_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key
INTEGRATION_ENCRYPTION_KEY_ID=v1

# Telegram Bot API. Токен бота сюда не добавляется.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT=10
# Публичный HTTPS-адрес CRM без завершающего слеша.
# Для локальной разработки используйте HTTPS-туннель.
TELEGRAM_WEBHOOK_BASE_URL=

# После скольких дней без сообщений считать, что клиент вернулся в чат.
CHAT_RETURNED_AFTER_DAYS=7
# Через сколько минут непрочитанное входящее сообщение считать пропущенным.
CHAT_MISSED_AFTER_MINUTES=15

# Общий Redis для WebSocket-событий, rate limits и временного cache.
# Может содержать пароль, поэтому production-значение хранится только в .env.
# Обычно достаточно REDIS_URL; отдельные URL переопределяют его при необходимости.
REDIS_URL=
CHANNEL_REDIS_URL=
CACHE_REDIS_URL=
REDIS_SOCKET_TIMEOUT=5
CHANNEL_CAPACITY=1000
CHANNEL_EXPIRY=60
CACHE_KEY_PREFIX=prodavan

# Загружаемые файлы. Для production используйте приватный S3-compatible bucket.
MEDIA_STORAGE_BACKEND=filesystem
MEDIA_ROOT=
# Только для production с общим persistent volume между всеми workers.
ALLOW_LOCAL_MEDIA_IN_PRODUCTION=False
S3_BUCKET_NAME=
S3_REGION_NAME=
S3_ENDPOINT_URL=
# Ключи можно не задавать при использовании IAM role/task identity.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SECURITY_TOKEN=
S3_LOCATION=media
S3_QUERYSTRING_EXPIRE=3600
S3_MAX_MEMORY_SIZE=5242880
S3_VERIFY_TLS=True
S3_ADDRESSING_STYLE=
S3_SERVER_SIDE_ENCRYPTION=AES256

# OpenAI-compatible API для эмбеддингов базы знаний. Ключ хранится только
# в .env. BASE_URL обычно оканчивается на /v1; endpoint /embeddings добавится
# автоматически. До настройки документы можно загружать, но индексация завершится
# ошибкой с возможностью повторной обработки.
AI_EMBEDDINGS_BASE_URL=
AI_EMBEDDINGS_API_KEY=
AI_EMBEDDINGS_MODEL=
AI_EMBEDDINGS_TIMEOUT=30
AI_EMBEDDINGS_BATCH_SIZE=32

# OpenAI-compatible Chat Completions API для AI-чата. Может использовать тот
# же провайдер и ключ, что и embeddings, но настраивается отдельно.
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_PROVIDER=openai-compatible
AI_CHAT_TIMEOUT=30
AI_CHAT_RETRY_ATTEMPTS=3
AI_CHAT_MAX_CONTEXT_TOKENS=20000
AI_CHAT_RETRIEVAL_LIMIT=5
AI_RETRIEVAL_MIN_SCORE=0.2

# Cookie
AUTH_REFRESH_COOKIE_NAME=refresh
# В production установите True вместе с DJANGO_*_COOKIE_SECURE выше.
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# Email. Для локальной разработки письма выводятся в консоль.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
